{
  "name": "peerd",
  "private": true,
  "type": "module",
  "version": "0.7.3",
  "description": "Browser-native AI agent harness. Source runs directly with no development build step; Bun is used for tests, Node (type stripping) for release tooling.",
  "license": "Apache-2.0",
  "homepage": "https://peerd.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/NotASithLord/peerd"
  },
  "bugs": {
    "url": "https://github.com/NotASithLord/peerd/issues"
  },
  "scripts": {
    "test": "bun test ./tests --timeout 15000",
    "test:functional:badge": "bun packaging/gen-functional-test-badge.ts",
    "test:watch": "bun test ./tests --watch",
    "red-team": "bun test ./tests/red-team",
    "red-team:report": "bun tests/red-team/report.ts",
    "test:netproc": "bun tests/peerd-distributed/netproc/run-cluster.ts",
    "test:twopeer": "bun scripts/cdp/run-dweb-twopeer.mjs",
    "test:twopeer:a2a": "A2A=1 bun scripts/cdp/run-dweb-twopeer.mjs",
    "test:twopeer:conv": "CONV=1 bun scripts/cdp/run-dweb-twopeer.mjs",
    "e2e:verify": "bun scripts/cdp/run-e2e-verify.mjs",
    "test:e2e": "bun scripts/cdp/run-e2e-verify.mjs --functional",
    "test:e2e:all": "bun scripts/cdp/run-e2e-verify.mjs --functional",
    "test:e2e:lifecycle": "bun scripts/cdp/run-lifecycle-faults.mjs",
    "test:e2e:goal": "bun scripts/cdp/run-e2e-verify.mjs --only=goal",
    "test:e2e:stop": "bun scripts/cdp/run-e2e-verify.mjs --only=stop",
    "test:e2e:error": "bun scripts/cdp/run-e2e-verify.mjs --only=error",
    "test:e2e:passkey": "bun scripts/cdp/run-passkey-signup.mjs",
    "test:firefox": "bun scripts/firefox/run-runtime-tests.mjs",
    "test:e2e:visual": "bun scripts/cdp/run-e2e-verify.mjs --visual",
    "test:e2e:visual:update": "UPDATE_BASELINES=1 bun scripts/cdp/run-e2e-verify.mjs --visual",
    "visual:vs-base": "bun scripts/cdp/visual-vs-base.mjs",
    "test:firefox:pod": "bun scripts/firefox/run-pod-smoke.mjs",
    "e2e:chrome": "bun scripts/cdp/ensure-chrome-for-testing.mjs",
    "eval:bench": "bun scripts/cdp/run-eval-bench.mjs",
    "eval:bench:smoke": "bun scripts/cdp/run-eval-bench.mjs --smoke",
    "eval:actors": "bun scripts/cdp/run-actor-orchestration-eval.mjs",
    "eval:context": "bun scripts/cdp/run-eval-context.mjs",
    "typecheck": "tsc",
    "lint": "eslint extension packaging/templates/web-shell",
    "package": "bun packaging/package.ts",
    "package:all": "bun packaging/package.ts --all",
    "package:web": "node --experimental-strip-types packaging/package-web.ts",
    "check:web": "node --experimental-strip-types packaging/check-web-boundary.ts",
    "preflight": "bun packaging/preflight.ts",
    "release": "bun packaging/release.ts",
    "feeds:check": "bun packaging/check-feeds.ts",
    "gen:dev": "node --experimental-strip-types packaging/gen-manifest.ts --channel=dev --browser=chrome && node --experimental-strip-types packaging/gen-channel-config.ts --channel=preview && node --experimental-strip-types packaging/gen-tscheck-badge.ts && node --experimental-strip-types packaging/gen-supply-chain-badges.ts",
    "gen:badge": "node --experimental-strip-types packaging/gen-tscheck-badge.ts",
    "gen:badge:functional": "bun packaging/gen-functional-test-badge.ts",
    "gen:badge:inbrowser": "bun packaging/gen-inbrowser-test-badge.ts",
    "gen:badge:gecko": "bun packaging/gen-gecko-test-badge.ts",
    "gen:badge:e2e": "bun packaging/gen-e2e-badge.ts",
    "gen:badge:red-team": "bun packaging/gen-red-team-badge.ts",
    "gen:badge:supply-chain": "node --experimental-strip-types packaging/gen-supply-chain-badges.ts",
    "check:actions": "node --experimental-strip-types packaging/check-action-pins.ts",
    "check:badges": "bun packaging/check-test-badges.ts",
    "check:boundary": "node --experimental-strip-types packaging/check-dweb-boundary.ts",
    "check:tscheck": "node --experimental-strip-types packaging/check-tscheck.ts",
    "check:imports": "bun packaging/check-packaged-imports.ts",
    "check:pages": "bun scripts/cdp/check-packaged-pages.mjs",
    "check:firefox": "bun packaging/check-firefox.ts",
    "check:docpaths": "bun packaging/check-doc-paths.ts",
    "check:hygiene": "bun packaging/check-source-hygiene.ts",
    "check:copy": "bun packaging/check-copy-hygiene.ts",
    "check:vendor": "node --experimental-strip-types packaging/check-vendor.ts",
    "check:invariants": "node --experimental-strip-types packaging/check-invariants.ts",
    "verify:store": "bun packaging/verify-store-artifact.ts",
    "feeds": "node --experimental-strip-types packaging/gen-update-feeds.ts",
    "vendor:pako": "node scripts/vendor-pako-esm.mjs",
    "vendor:codemirror": "bun run scripts/vendor-codemirror.ts"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.2.0",
    "@types/webextension-polyfill": "^0.12.5",
    "codemirror": "^6.0.2",
    "crx3": "2.0.0",
    "es-module-lexer": "^2.3.0",
    "eslint": "10.4.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "puppeteer-core": "^25.5.0",
    "typescript": "^6.0.3",
    "web-ext": "10.6.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "patchedDependencies": {
    "image-size@2.0.2": "patches/image-size@2.0.2.patch"
  }
}
